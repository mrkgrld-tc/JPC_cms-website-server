    },
    "vission": {
      "type": "richtext"
    },
    "quality_policy": {
      "type": "richtext"
    },
    "institutional_goals": {
      "type": "richtext"
    },
    "institutional_objectives": {
      "type": "richtext"
    },
    "board_members": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::board-member.board-member"
    }
