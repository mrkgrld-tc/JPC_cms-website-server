{
  "kind": "collectionType",
  "collectionName": "programs",
  "info": {
    "singularName": "program",
    "pluralName": "programs",
    "displayName": "Program"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "department": {
      "type": "string"
    },
    "duration": {
      "type": "string"
    },
    "degree_type": {
      "type": "enumeration",
      "enum": [
        "Bachelor",
        "Master",
        "Doctorate",
        "Certificate"
      ]
    },
    "description": {
      "type": "richtext"
    },
    "cover_image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    }
  }
}
